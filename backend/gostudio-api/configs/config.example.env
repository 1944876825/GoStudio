# gostudio-api 环境变量示例（docker-compose.yml 里已内置同一份说明）

# ===== 服务 =====
GOSTUDIO_API_ADDR=:8080
# sqlite 数据与运行数据目录（容器内默认 /data）
GOSTUDIO_API_DATA_DIR=./data
# 反向代理若不剥 /api 前缀，设为 /api（默认为空 = 代理已剥前缀）
GOSTUDIO_API_ROUTE_PREFIX=

# ===== 客户端鉴权 =====
# 逗号分隔多个 key；为空 = 不鉴权（仅建议内网调试）
# App 端崩溃上报用 X-GoStudio-Backend-Key，翻译沿用 X-GoStudio-Translation-Key
GOSTUDIO_API_KEYS=

# ===== 管理后台（/admin）=====
GOSTUDIO_API_ADMIN_USERNAME=admin
GOSTUDIO_API_ADMIN_PASSWORD=            # 必填
GOSTUDIO_API_ADMIN_JWT_SECRET=          # 必填，>=16 字符

# ===== 翻译模块（与旧 translation-api 完全同名，可直接迁移）=====
# 可选：mock / openai / google / deepl
TRANSLATION_PROVIDER=openai
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.6
LLM_API_KEY=
# LLM_API_KEY_HEADER=Authorization
# GOOGLE_TRANSLATE_API_KEY=
# DEEPL_API_KEY=
# 兼容变量：旧服务的 TRANSLATION_BACKEND_API_KEYS 也会被读取
