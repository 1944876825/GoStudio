<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 应用数据在私有目录；公共文件按需交给系统文件选择器处理 -->

    <!-- 编译产物导出到公共 Download/gostudio/bin：Android 9 及以下需要写存储权限，10+ 走 MediaStore -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- 保活权限 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- 其他 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 应用内更新：下载 APK 后唤起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    
    <application
        android:allowBackup="true"
        android:supportsRtl="true"
        android:name=".gostudio_application"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ComposeEmptyActivity">
        
        <activity
            android:name=".activity.splash_activity"
            android:exported="true"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".activity.crash.crash_activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ComposeEmptyActivity" />
        
        <activity
            android:name=".activity.main_activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />
            
        <activity
            android:name=".activity.install_activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />
            
        <activity
            android:name=".activity.terminal_activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />
            
        <activity
            android:name=".runtime.runtime_host_activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.GoStudio.MaterialSharedAxis"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".designer.layout_designer_activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.GoStudio.MaterialSharedAxis"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".activity.editor_activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />
            
        <service
            android:name=".service.keep_alive_service"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.foreground_service_type_special_use_description"
                android:value="Continuous operation in the background" />
        </service>

        <!-- 应用内更新：向系统安装器共享下载的 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.file_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
